# ============================================================
# 复制成 .env 后填写。绝不要把 .env 提交到仓库。
# ============================================================

# ---------------- LLM ----------------
# 按下面的顺序挑一条，把其余的注释掉。
# 一条都不配 = 退回离线规则模拟器（MockAnalyzer）：能跑通流程，但不是真模型。

# 【推荐·零成本】本地 Ollama。不要 Key、不花钱、数据不出本机。
# 实测（本机推理，单次判断约 500 token 上下文）：
#   qwen2.5:7b    16.6s  ✅ 输出稳定、JSON 规整        ← 推荐
#   qwen3:8b      92.2s  ⚠️ 思考模式把时间拖了十倍
#   qwen3:4b      16.6s  ❌ 输出额度被思考耗尽，拿到空串
#   llama3.2       9.6s  ❌ 判断自相矛盾（score=2 却给 BUY）
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# 本地模型必须限输出长度，否则小模型能被自己的啰嗦拖死
LLM_MAX_TOKENS=200

# 【云端】DeepSeek。便宜、国内直连，但账户要有余额
# 注意：HTTP 401 = Key 无效；HTTP 402 = Key 有效但余额为 0。两者完全不同。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# 【云端】通义千问（OpenAI 兼容模式）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=qwen-plus

# ---------------- 数据源 ----------------
# tushare 是主源（config.yaml 里排第一），需要 token + pip install tushare。
# 没配 token 也能跑：自动降级到腾讯 / 东财（零配置，但东财有 IP 级限流）。
#
# token 获取：https://tushare.pro/user/token  （注册后在「个人主页」复制）
#
# 配完先跑一次体检，它会逐个接口戳一遍，告诉你哪些能用：
#     python main.py doctor
#
# ⚠️ 积分与频次（本机实测，非文档抄录）：
#   daily          历史日线（主源）    ✅ 自由调用（连续 4 次并发无压力）
#   adj_factor     复权因子           ⛔ 40203 频率超限（1 次/小时）
#   daily_basic    每日指标（换手率）  ⛔ 40203 频率超限（1 次/小时）
#   index_daily    指数日线（基准）    ⛔ 40203 频率超限（1 次/小时）
#
#   ⚠️ tushare 把「积分不够」也报成「频率超限」，报错原文长得一模一样，
#      别一看到限流就去改代码。
#
#   这三个限流接口都已经用磁盘缓存化解 —— 判断依据是「数据多久变一次」：
#     adj_factor   只在分红除权日变（一年一两次）→ TTL 7 天
#     index_daily  / daily_basic  只追加不回改   → TTL 1 天
#   整段历史一次拉下来落盘，日常跑日报不会再碰这些接口。
#   代价：首次抓每只股票占用 1 次配额，抓完进入缓存期。
TUSHARE_TOKEN=

# ---------------- 推送通道（填哪个开哪个）----------------
WECOM_WEBHOOK=
FEISHU_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=
SLACK_WEBHOOK=

# 邮件推送
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
